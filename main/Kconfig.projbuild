menu "PhotoPainter Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            WiFi password (WPA or WPA2) to use.

    config TIMEZONE
        string "Timezone"
        default "JST-9"
        help
            POSIX timezone string (e.g., JST-9 for Japan).

    config DISABLE_DEEP_SLEEP
        bool "Disable deep sleep (debug)"
        default n
        help
            Keep running without entering deep sleep.

endmenu
