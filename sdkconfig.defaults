# ESP32-S3 PhotoPainter Board Configuration
# Target: ESP32-S3

# PSRAM Configuration (Octal mode for PhotoPainter board)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Main task stack size (larger for complex operations)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Flash Size (physical flash on the target board is 16 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi Configuration
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# HTTPS/TLS Support
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=16384
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# NVS
CONFIG_NVS_ENCRYPTION=n

# Log Level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Power Management
CONFIG_PM_ENABLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y

# Deep Sleep
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=y

# ============================================================
# Weather Calendar Configuration
# ============================================================
# Secret values - set via menuconfig or environment:
#   CONFIG_WIFI_SSID
#   CONFIG_WIFI_PASSWORD
#   CONFIG_OPENWEATHERMAP_API_KEY
#   CONFIG_TODOIST_API_TOKEN

# Location (Tokyo default)
CONFIG_LOCATION_LATITUDE="35.6762"
CONFIG_LOCATION_LONGITUDE="139.6503"
CONFIG_TIMEZONE="JST-9"

# Update intervals
CONFIG_DISABLE_DEEP_SLEEP=y
CONFIG_UPDATE_INTERVAL_DAY_MIN=30
CONFIG_UPDATE_INTERVAL_NIGHT_MIN=120
CONFIG_API_CALL_INTERVAL_HOURS=3
